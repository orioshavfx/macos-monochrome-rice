+    #[test]
+    fn a_new_window_keeps_its_own_width_when_it_splits() {
+        // A 300 wide window next to a full-width one takes 300 of the 1000.
+        let mut t = BspTree::new();
+        assert!(t.insert(1, None, AREA, GAP, 0.5));
+        assert!(t.insert_sized(2, Some(1), AREA, GAP, 0.5, Some((300, 600))));
+        let right = frame(&t, 2).w;
+        assert!((right - 300).abs() <= 2, "right slot was {right}");
+        assert_eq!(frame(&t, 1).w + GAP + right, AREA.w);
+    }
