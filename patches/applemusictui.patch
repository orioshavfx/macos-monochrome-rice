diff --git a/internal/lyrics/lrclib.go b/internal/lyrics/lrclib.go
new file mode 100644
index 0000000..14bff4c
--- /dev/null
+++ b/internal/lyrics/lrclib.go
@@ -0,0 +1,132 @@
+// Package lyrics fetches song lyrics from LRCLIB (https://lrclib.net), a free,
+// community-maintained lyrics database. No API key is required.
+package lyrics
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+var baseURL = "https://lrclib.net/api"
+
+// ErrNotFound means LRCLIB has no lyrics for the given track.
+var ErrNotFound = errors.New("lyrics not found")
+
+var httpClient = &http.Client{Timeout: 8 * time.Second}
+
+// timeTag matches a leading LRC timestamp such as "[00:12.34]".
+var timeTag = regexp.MustCompile(`^\[[0-9:.]+\]\s*`)
+
+type record struct {
+	PlainLyrics  string `json:"plainLyrics"`
+	SyncedLyrics string `json:"syncedLyrics"`
+	Instrumental bool   `json:"instrumental"`
+}
+
+// Fetch returns the lyrics text for a track.
+//
+// LRCLIB's /get endpoint matches exactly on album and duration, so a mismatch
+// (for example a "Single" album name) returns 404. Fetch therefore tries, in
+// order: the full query, a query with only track and artist, and finally a
+// search by track and artist that takes the first record with lyrics.
+func Fetch(track, artist, album string, duration float64) (string, error) {
+	q := url.Values{}
+	q.Set("track_name", track)
+	q.Set("artist_name", artist)
+	if album != "" {
+		q.Set("album_name", album)
+	}
+	if duration > 0 {
+		q.Set("duration", strconv.Itoa(int(math.Round(duration))))
+	}
+
+	var r record
+	err := request("/get", q, &r)
+
+	if errors.Is(err, ErrNotFound) {
+		loose := url.Values{}
+		loose.Set("track_name", track)
+		loose.Set("artist_name", artist)
+		err = request("/get", loose, &r)
+	}
+
+	if errors.Is(err, ErrNotFound) {
+		var results []record
+		if err = request("/search", url.Values{
+			"track_name":  {track},
+			"artist_name": {artist},
+		}, &results); err != nil {
+			return "", err
+		}
+		for _, candidate := range results {
+			if text, ok := textOf(candidate); ok {
+				return text, nil
+			}
+		}
+		return "", ErrNotFound
+	}
+
+	if err != nil {
+		return "", err
+	}
+	if text, ok := textOf(r); ok {
+		return text, nil
+	}
+	return "", ErrNotFound
+}
+
+// request calls one LRCLIB endpoint and decodes the JSON body into out.
+func request(path string, q url.Values, out any) error {
+	req, err := http.NewRequest(http.MethodGet, baseURL+path+"?"+q.Encode(), nil)
+	if err != nil {
+		return err
+	}
+	req.Header.Set("User-Agent", "AppleMusicTUI/1.0 (https://github.com/sebasreateguib/AppleMusicTUI)")
+
+	resp, err := httpClient.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode == http.StatusNotFound {
+		return ErrNotFound
+	}
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("lrclib: HTTP %d", resp.StatusCode)
+	}
+	return json.NewDecoder(resp.Body).Decode(out)
+}
+
+// textOf picks the displayable text from a record.
+func textOf(r record) (string, bool) {
+	if r.Instrumental {
+		return "Instrumental track", true
+	}
+	if text := strings.TrimSpace(r.PlainLyrics); text != "" {
+		return text, true
+	}
+	if synced := stripTimeTags(r.SyncedLyrics); synced != "" {
+		return synced, true
+	}
+	return "", false
+}
+
+// stripTimeTags turns LRC text ("[00:12.34] line") into plain lines.
+func stripTimeTags(lrc string) string {
+	lines := strings.Split(lrc, "\n")
+	out := make([]string, 0, len(lines))
+	for _, line := range lines {
+		line = strings.TrimSpace(timeTag.ReplaceAllString(strings.TrimSpace(line), ""))
+		out = append(out, line)
+	}
+	return strings.TrimSpace(strings.Join(out, "\n"))
+}
