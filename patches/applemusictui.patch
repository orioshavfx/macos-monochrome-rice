diff --git a/internal/ui/panels/lyrics.go b/internal/ui/panels/lyrics.go
new file mode 100644
index 0000000..74722ed
--- /dev/null
+++ b/internal/ui/panels/lyrics.go
@@ -0,0 +1,46 @@
+package panels
+
+import (
+	"strings"
+
+	"github.com/charmbracelet/lipgloss"
+
+	"SR-Player/internal/models"
+)
+
+// RenderLyricsPanel draws the lyrics of the current track inside a bordered box.
+// Long lyrics are cut to the panel height (no scrolling yet).
+func RenderLyricsPanel(width, height int, track models.Track, text, errMsg string, loading bool) string {
+	if height <= 0 || width <= 0 {
+		return ""
+	}
+	innerW := width - 4 // border (2) + side padding (2)
+	innerH := height - 2
+	if innerW < 4 || innerH < 3 {
+		return ""
+	}
+
+	header := track.Name
+	if track.Artist != "" {
+		header += " — " + track.Artist
+	}
+
+	var body string
+	switch {
+	case track.Name == "":
+		body = "Nothing playing"
+	case loading:
+		body = "Loading lyrics..."
+	case errMsg != "":
+		body = errMsg
+	default:
+		body = text
+	}
+
+	wrapped := lipgloss.NewStyle().Width(innerW).Render(header + "\n\n" + body)
+	lines := strings.Split(wrapped, "\n")
+	if len(lines) > innerH {
+		lines = lines[:innerH]
+	}
+	return renderRectBox(strings.Join(lines, "\n"), width, height, lipgloss.Color("#FFFFFF"), lipgloss.Top)
+}
