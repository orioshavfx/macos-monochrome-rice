+package lyrics
+
+import "testing"
+
+func TestStripTimeTags(t *testing.T) {
+	in := "[00:12.34] First line\n[00:15.00]Second line\n[00:20.00] \n"
+	want := "First line\nSecond line"
+	if got := stripTimeTags(in); got != want {
+		t.Fatalf("stripTimeTags() = %q, want %q", got, want)
+	}
+}
