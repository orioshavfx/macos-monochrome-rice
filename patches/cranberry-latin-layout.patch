+/// The Latin layout (ABC or US), retained: the caller releases it. Looked up
+/// by id rather than through the "ASCII capable" call, which can return the
+/// selected non-Latin layout (such as Russian). Null when neither is installed.
+unsafe fn latin_layout_source() -> CFTypeRef {
+    unsafe {
+        let list = TISCreateInputSourceList(ptr::null(), 1);
+        if list.is_null() {
+            return ptr::null();
+        }
+        let mut found: CFTypeRef = ptr::null();
+        for i in 0..CFArrayGetCount(list) {
+            let src = CFArrayGetValueAtIndex(list, i);
+            let id = string_value(TISGetInputSourceProperty(src, kTISPropertyInputSourceID))
+                .unwrap_or_default();
+            if id == "com.apple.keylayout.ABC" || id == "com.apple.keylayout.US" {
+                found = CFRetain(src);
+                break;
+            }
+        }
+        CFRelease(list);
+        found
+    }
+}
