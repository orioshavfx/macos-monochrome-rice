{
  // Монохромный fastfetch. Положить в ~/.config/fastfetch/config.jsonc
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "#ffffff",
      "2": "#d0d0d0",
      "3": "#b0b0b0",
      "4": "#909090",
      "5": "#777777",
      "6": "#5a5a5a",
      "7": "#ffffff",
      "8": "#c0c0c0",
      "9": "#8a8a8a"
    }
  },
  "display": {
    "color": {
      "keys": "#ffffff",
      "title": "#ffffff",
      "output": "#a0a0a0",
      "separator": "#5a5a5a"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "uptime",
    "shell",
    "de",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "netio",
    "datetime",
    "media",
    "break",
    "colors"
  ]
}
