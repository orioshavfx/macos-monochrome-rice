#!/usr/bin/env bash
# wallpicker: set the desktop picture on every desktop (bound to opt+w in cberry).
#
#   wallpicker            open a file dialog in ~/Pictures/Wallpapers
#   wallpicker FILE       set FILE without a dialog
#
# Uses osascript, so it needs no terminal window. The first run asks for
# permission to control "System Events" (System Settings > Privacy & Security >
# Automation). Cancelling the dialog changes nothing.
set -Eeuo pipefail

DIR="$HOME/Pictures/Wallpapers"

if [ "$#" -ge 1 ]; then
    [ -f "$1" ] || { echo "wallpicker: no such file: $1" >&2; exit 1; }
    pic="$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
else
    mkdir -p "$DIR"
    # Cancel raises an error inside the try block, which returns an empty string.
    pic="$(osascript \
        -e 'on run argv' \
        -e 'try' \
        -e 'set f to choose file with prompt "Wallpaper:" default location (POSIX file (item 1 of argv)) of type {"public.image"}' \
        -e 'return POSIX path of f' \
        -e 'on error' \
        -e 'return ""' \
        -e 'end try' \
        -e 'end run' \
        "$DIR")"
    [ -n "$pic" ] || exit 0
fi

osascript \
    -e 'on run argv' \
    -e 'tell application "System Events" to tell every desktop to set picture to (item 1 of argv)' \
    -e 'end run' \
    "$pic"

echo "wallpicker: $pic"
